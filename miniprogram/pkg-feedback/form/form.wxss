.fb-kinds { display: flex; flex-wrap: wrap; gap: 9px; margin-bottom: 12px; }
.fb-kind {
  padding: 9px 16px; border-radius: 10px;
  background: #F2F5F9; color: var(--text-2);
  font-size: 13.5px; border: 1px solid transparent;
}
.fb-kind.fb-hover { opacity: .85; }
.fb-kind.on { background: var(--primary-light); color: var(--primary); border-color: var(--primary); font-weight: 600; }
.fb-input {
  width: 100%; min-height: 92px;
  background: #F7F9FC; border-radius: 11px; padding: 11px 13px;
  font-size: 14px; line-height: 1.6; color: var(--text);
}
.fb-ph { color: var(--text-3); font-size: 13.5px; }
.fb-count { text-align: right; font-size: 11.5px; color: var(--text-3); margin-top: 5px; }
.fb-tip { font-size: 12px; color: var(--text-3); line-height: 1.6; padding: 2px 4px 14px; }
