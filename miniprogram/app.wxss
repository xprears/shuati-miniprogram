/* 全局样式 —— 刷题宝 · 题库练习小程序（标签规范：view/text/button，选择器全部用 class） */
page {
  --primary: #1B4F9C;
  --primary-deep: #123B78;
  --primary-light: #E8F0FC;
  --accent: #0E9F8A;
  --bg: #F4F6FA;
  --card: #FFFFFF;
  --line: #E4E9F2;
  --text: #1A2333;
  --text-2: #5A6679;
  --text-3: #93A0B4;
  --green: #16A34A;
  --green-bg: #E9F8EF;
  --red: #DC2626;
  --red-bg: #FDECEC;
  --orange: #D97706;
  --orange-bg: #FDF3E3;
  --radius: 14px;
  background: var(--bg);
  color: var(--text);
  font-size: 15px;
  line-height: 1.6;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", "Microsoft YaHei", sans-serif;
  /* 微信 WebView 模式下 page 默认 content-box，padding 会把右内侧顶出屏幕导致整页可左右滑动；
     border-box + overflow-x 兜底，双保险 */
  box-sizing: border-box;
  width: 100%;
  overflow-x: hidden;
  padding: 14px 14px 18px;
}
/* 全局盒模型：微信默认只有 button 自带 border-box，其余组件均为 content-box */
page, view, button, text, scroll-view, swiper, swiper-item, cover-view, cover-image,
movable-view, movable-area, navigator, image, icon, progress, rich-text, form, input,
textarea, label, picker, picker-view, slider, switch, radio-group, checkbox-group,
checkbox, radio, audio, video, canvas, web-view, live-player, live-pusher, open-data,
functional-page-navigator {
  box-sizing: border-box;
}
button { padding: 0; margin: 0; background: none; font-size: inherit; line-height: inherit; }
button::after { border: none; }

/* ---------- 通用组件 ---------- */
.card { background: var(--card); border-radius: var(--radius); box-shadow: 0 1px 3px rgba(16,34,73,.06), 0 4px 14px rgba(16,34,73,.05); padding: 15px; margin-bottom: 12px; }
.card-title { font-size: 13px; color: var(--text-2); font-weight: 600; margin-bottom: 10px; display: flex; align-items: center; justify-content: space-between; }
.btn {
  display: flex; align-items: center; justify-content: center; gap: 7px;
  width: 100%; padding: 13px; border-radius: 12px;
  background: var(--primary); color: #fff; font-size: 15.5px; font-weight: 600;
  transition: transform .08s, opacity .08s;
}
.btn.hover { opacity: .92; }
.btn.ghost { background: var(--primary-light); color: var(--primary); }
.btn.green { background: var(--green); }
.btn.gray { background: #EEF1F6; color: var(--text-2); }
.btn.sm { padding: 8px 14px; font-size: 13.5px; border-radius: 9px; width: auto; }
.btn[disabled] { opacity: .45; }
.row { display: flex; gap: 10px; }
.row > view { flex: 1; }
.tag { display: inline-flex; align-items: center; padding: 2px 8px; border-radius: 6px; font-size: 11.5px; font-weight: 500; background: var(--primary-light); color: var(--primary); }
.tag.green { background: var(--green-bg); color: var(--green); }
.tag.red { background: var(--red-bg); color: var(--red); }
.tag.orange { background: var(--orange-bg); color: var(--orange); }
.tag.gray { background: #EEF1F6; color: var(--text-2); }
.muted { color: var(--text-2); font-size: 13px; }
.muted-2 { color: var(--text-3); font-size: 12px; }
.divider { height: 1px; background: var(--line); margin: 12px 0; }
.empty { text-align: center; padding: 48px 20px; color: var(--text-3); }
.empty .ic { width: 46px; height: 46px; margin: 0 auto 10px; opacity: .5; font-size: 40px; }
.progress-track { height: 6px; background: #E9EDF4; border-radius: 99px; overflow: hidden; }
.progress-track > view { height: 100%; background: var(--primary); border-radius: 99px; transition: width .25s; }
.progress-track.green > view { background: var(--green); }
.progress-track.red > view { background: var(--red); }
.kv-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 9px; }
.kv { background: #F7F9FC; border-radius: 11px; padding: 11px 13px; }
.kv .num { font-size: 17px; font-variant-numeric: tabular-nums; display: block; }
.kv .lbl { font-size: 11.5px; color: var(--text-2); display: block; }
.bar-row { display: flex; align-items: center; gap: 10px; margin-bottom: 9px; font-size: 12.5px; }
.bar-row .name { width: 86px; flex-shrink: 0; color: var(--text-2); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.bar-row .track { flex: 1; height: 8px; background: #EDF1F7; border-radius: 99px; overflow: hidden; }
.bar-row .track > view { height: 100%; border-radius: 99px; }
.bar-row .val { width: 44px; text-align: right; font-variant-numeric: tabular-nums; color: var(--text-2); flex-shrink: 0; }

/* ---------- 首页 ---------- */
.hero { background: linear-gradient(135deg, var(--primary) 0%, var(--primary-deep) 100%); border-radius: var(--radius); padding: 18px; color: #fff; margin-bottom: 14px; box-shadow: 0 1px 3px rgba(16,34,73,.06), 0 4px 14px rgba(16,34,73,.05); }
.hero .hero-title { font-size: 15px; font-weight: 700; line-height: 1.35; }
.hero .sub { font-size: 12.5px; opacity: .82; margin-top: 3px; }
.hero-stats { display: flex; margin-top: 15px; }
.hero-stats > view { flex: 1; text-align: center; }
.hero-stats .num { font-size: 20px; font-variant-numeric: tabular-nums; display: block; }
.hero-stats .lbl { font-size: 11px; opacity: .78; margin-top: 1px; display: block; }
.mode-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 11px; margin-bottom: 12px; }
.mode-card { background: var(--card); border-radius: var(--radius); box-shadow: 0 1px 3px rgba(16,34,73,.06), 0 4px 14px rgba(16,34,73,.05); padding: 15px 13px; text-align: left; display: flex; flex-direction: column; gap: 6px; min-height: 96px; }
.mode-card.hover { transform: scale(.97); }
.mode-card .ic { width: 38px; height: 38px; border-radius: 11px; display: flex; align-items: center; justify-content: center; }
.mode-card .ic text { font-size: 19px; }
.mode-card .t { font-size: 15px; font-weight: 600; }
.mode-card .d { font-size: 11.5px; color: var(--text-2); line-height: 1.4; }
.ic.blue { background: var(--primary-light); color: var(--primary); }
.ic.teal { background: #E2F6F2; color: var(--accent); }
.ic.orange { background: var(--orange-bg); color: var(--orange); }
.ic.red { background: var(--red-bg); color: var(--red); }
.resume-banner { display: flex; align-items: center; gap: 11px; background: var(--card); border-radius: var(--radius); box-shadow: 0 1px 3px rgba(16,34,73,.06), 0 4px 14px rgba(16,34,73,.05); padding: 13px 15px; margin-bottom: 12px; border-left: 4px solid var(--accent); }
.resume-banner .grow { flex: 1; min-width: 0; }
.resume-banner .t { font-size: 14.5px; font-weight: 600; display: block; }
.resume-banner .d { font-size: 12px; color: var(--text-2); display: block; }

/* ---------- 分类管理 ---------- */
.part-block { margin-bottom: 14px; }
.part-name { font-size: 13px; font-weight: 700; color: var(--text-2); padding: 4px 2px 9px; display: flex; align-items: center; gap: 7px; }
.part-name .count { font-weight: 500; color: var(--text-3); font-size: 12px; }
.chapter-row { background: var(--card); border-radius: 12px; box-shadow: 0 1px 3px rgba(16,34,73,.06), 0 4px 14px rgba(16,34,73,.05); padding: 12px 13px; margin-bottom: 9px; }
.chapter-row .head { display: flex; align-items: center; gap: 9px; }
.chapter-row .head .grow { flex: 1; min-width: 0; }
.chapter-row .t { font-size: 14.5px; font-weight: 600; display: block; }
.chapter-row .sub { font-size: 11.5px; color: var(--text-3); margin-top: 1px; }
.eye-btn { width: 32px; height: 32px; border-radius: 8px; display: flex; align-items: center; justify-content: center; color: var(--text-3); background: #F2F5F9; flex-shrink: 0; }
.eye-btn text { font-size: 15px; }
.eye-btn.off { color: #C3CCDA; }
.chapter-row.dim { opacity: .55; }
.chapter-actions { display: flex; gap: 8px; margin-top: 10px; }
.chapter-actions .btn { padding: 8px 12px; font-size: 12.5px; border-radius: 8px; }
.mini-stats { display: flex; gap: 12px; margin-top: 9px; font-size: 11.5px; color: var(--text-2); }
.mini-stats .num { color: var(--text); font-variant-numeric: tabular-nums; font-weight: 600; }

/* ---------- 练习设置 ---------- */
.chip { padding: 7px 13px; border-radius: 99px; background: #EEF1F6; color: var(--text-2); font-size: 13px; border: 1px solid transparent; display: inline-flex; }
.chip.on { background: var(--primary-light); color: var(--primary); border-color: var(--primary); font-weight: 600; }
.chip-row { display: flex; gap: 8px; flex-wrap: wrap; }
.count-pill { padding: 8px 15px; border-radius: 10px; background: #EEF1F6; font-size: 14px; font-weight: 600; color: var(--text-2); font-variant-numeric: tabular-nums; display: inline-flex; }
.count-pill.on { background: var(--primary); color: #fff; }
.scope-item { display: flex; align-items: center; gap: 10px; padding: 11px 4px; border-bottom: 1px solid var(--line); }
.scope-item.last { border-bottom: none; }
.scope-item .grow { flex: 1; min-width: 0; }
.scope-item .t { font-size: 14px; font-weight: 500; display: block; }
.scope-item .d { font-size: 11.5px; color: var(--text-3); display: block; }
.check { width: 21px; height: 21px; border-radius: 6px; border: 1.5px solid #C9D3E2; display: flex; align-items: center; justify-content: center; flex-shrink: 0; color: #fff; font-size: 12px; }
.check.on { background: var(--primary); border-color: var(--primary); }

/* ---------- 答题页 ---------- */
.exam-bar { display: flex; align-items: center; justify-content: center; gap: 8px; background: var(--orange-bg); color: var(--orange); border-radius: 10px; padding: 8px; margin-bottom: 12px; font-weight: 700; font-variant-numeric: tabular-nums; font-size: 15px; }
.exam-bar.urgent { background: var(--red-bg); color: var(--red); animation: blink 1s infinite; }
@keyframes blink { 50% { opacity: .35; } }
.qmeta { display: flex; align-items: center; gap: 7px; flex-wrap: wrap; margin-bottom: 11px; }
.qstem { font-size: 16px; line-height: 1.72; font-weight: 500; word-break: break-all; overflow-wrap: break-word; }
.opt { display: flex; align-items: flex-start; gap: 11px; width: 100%; text-align: left; background: var(--card); border: 1.5px solid var(--line); border-radius: 12px; padding: 12px 13px; margin-bottom: 10px; font-size: 14.5px; line-height: 1.6; transition: border-color .12s, background .12s; }
.opt .key { width: 26px; height: 26px; border-radius: 8px; background: #EEF1F6; color: var(--text-2); display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 13px; flex-shrink: 0; }
.opt .txt { flex: 1; min-width: 0; word-break: break-all; overflow-wrap: break-word; }
.opt.sel { border-color: var(--primary); background: var(--primary-light); }
.opt.sel .key { background: var(--primary); color: #fff; }
.opt.correct { border-color: var(--green); background: var(--green-bg); }
.opt.correct .key { background: var(--green); color: #fff; }
.opt.wrong { border-color: var(--red); background: var(--red-bg); }
.opt.wrong .key { background: var(--red); color: #fff; }
.opt.hover { opacity: .85; }
.opt.locked { pointer-events: none; }
.feedback { border-radius: 12px; padding: 13px; font-size: 14px; line-height: 1.65; margin-bottom: 12px; word-break: break-all; overflow-wrap: break-word; }
.feedback.right { background: var(--green-bg); color: #14532D; }
.feedback.wrong { background: var(--red-bg); color: #7F1D1D; }
.feedback .ft { font-weight: 700; display: block; margin-bottom: 3px; }
.qfoot { display: flex; gap: 10px; margin-top: 14px; margin-bottom: 12px; }
.qfoot .btn { flex: 1; }
/* 掌握度标记行：紧接「答题卡 / 退出练习」那一行，放在页面最底部 */
.mark-row { display: flex; gap: 10px; margin-bottom: 14px; }
.mark-row .btn { flex: 1; padding: 11px 14px; font-size: 14.5px; border-radius: 11px; }
/* ⚠️ pre-wrap 只能挂在正文 view 上，不能挂 .ref-box：
   white-space 是继承属性，挂在容器上会把 WXML 标签之间的缩进换行也当成有效空白渲染成空行，
   按钮上下各多出 58px / 38px 的空白（2026-10-13 修）。 */
.ref-box { background: #F7F9FC; border: 1px solid var(--line); border-radius: 12px; padding: 13px; font-size: 13.5px; line-height: 1.75; margin-bottom: 12px; word-break: break-all; overflow-wrap: break-word; }
.ref-box view { white-space: pre-wrap; }
.ref-box .rt { font-size: 12.5px; color: var(--accent); margin-bottom: 6px; font-weight: 600; }
/* 解析右下角的「解析反馈」按钮：左对齐、宽度自适应 */
.ref-actions { margin-top: 11px; display: flex; white-space: normal; }
.ref-actions .btn { width: auto; }
.nav-actions { display: flex; gap: 10px; margin-bottom: 14px; }
.nav-actions .btn { flex: 1; padding: 11px 14px; font-size: 15px; border-radius: 11px; }

/* ---------- 答题卡浮层 ---------- */
.acard-mask { position: fixed; left: 0; top: 0; right: 0; bottom: 0; background: rgba(15,23,42,.5); z-index: 90; display: flex; align-items: flex-end; justify-content: center; }
.acard-sheet { background: var(--card); border-radius: 18px 18px 0 0; width: 100%; max-height: 82vh; display: flex; flex-direction: column; }
.acard-head { display: flex; align-items: center; padding: 15px 16px 11px; border-bottom: 1px solid var(--line); }
.acard-head .t { flex: 1; font-size: 16px; font-weight: 600; }
.acard-body { padding: 14px 16px; overflow-y: auto; }
.acard-foot { padding: 12px 16px calc(14px + env(safe-area-inset-bottom)); border-top: 1px solid var(--line); }
.acard-legend { display: flex; gap: 13px; flex-wrap: wrap; font-size: 11.5px; color: var(--text-2); margin-bottom: 13px; }
.acard-legend .lg { display: flex; align-items: center; gap: 4px; }
.acard-legend .dot { display: inline-block; width: 11px; height: 11px; border-radius: 3px; }
.acard-grid { display: grid; grid-template-columns: repeat(6, 1fr); gap: 8px; }
.acell { aspect-ratio: 1; border-radius: 9px; background: #F0F3F8; color: var(--text-2); font-size: 13px; font-weight: 600; display: flex; align-items: center; justify-content: center; border: 1.5px solid transparent; font-variant-numeric: tabular-nums; }
.acell.done { background: var(--primary); color: #fff; }
.acell.flagged { background: var(--orange-bg); color: var(--orange); border-color: var(--orange); }
.acell.cur { border-color: var(--accent); box-shadow: 0 0 0 1px var(--accent); }
.acell.mark-wrong { background: var(--red-bg); color: var(--red); }
.acell.mark-right { background: var(--green-bg); color: var(--green); }

/* ---------- 结果页 ---------- */
.score-hero { text-align: center; padding: 26px 15px 20px; }
.score-hero .num { font-size: 46px; font-weight: 800; color: var(--primary); font-variant-numeric: tabular-nums; line-height: 1; }
.score-hero .lbl { font-size: 13px; color: var(--text-2); margin-top: 6px; }
.score-hero .verdict { display: inline-block; margin-top: 11px; padding: 4px 14px; border-radius: 99px; font-size: 13px; font-weight: 600; }
.verdict.pass { background: var(--green-bg); color: var(--green); }
.verdict.fail { background: var(--red-bg); color: var(--red); }
.result-row { display: flex; align-items: center; gap: 10px; padding: 11px 2px; border-bottom: 1px solid var(--line); font-size: 13.5px; }
.result-row.last { border-bottom: none; }
.result-row .no { width: 26px; color: var(--text-3); font-variant-numeric: tabular-nums; flex-shrink: 0; }
.result-row .grow { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
.result-row .st { flex-shrink: 0; font-size: 12px; font-weight: 600; }

/* ---------- 未掌握列表 ---------- */
.wrong-row { background: var(--card); border-radius: 12px; box-shadow: 0 1px 3px rgba(16,34,73,.06), 0 4px 14px rgba(16,34,73,.05); padding: 12px 13px; margin-bottom: 9px; }
.wrong-row .head { display: flex; align-items: flex-start; gap: 9px; }
.wrong-row .grow { flex: 1; min-width: 0; font-size: 14px; line-height: 1.6; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.wrong-row .meta { display: flex; gap: 10px; margin-top: 8px; font-size: 11.5px; color: var(--text-3); }

/* ---------- 学习报告 ---------- */
.weak-item { display: flex; align-items: center; gap: 10px; padding: 10px 2px; border-bottom: 1px solid var(--line); font-size: 13.5px; }
.weak-item.last { border-bottom: none; }
.weak-item .grow { flex: 1; min-width: 0; }
.weak-item .rank { width: 20px; height: 20px; border-radius: 6px; background: var(--red-bg); color: var(--red); font-size: 11.5px; font-weight: 700; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.hist-row { display: flex; align-items: center; gap: 10px; padding: 11px 2px; border-bottom: 1px solid var(--line); }
.hist-row.last { border-bottom: none; }
.hist-row .sc { width: 44px; height: 44px; border-radius: 12px; display: flex; flex-direction: column; align-items: center; justify-content: center; font-weight: 800; font-size: 16px; flex-shrink: 0; font-variant-numeric: tabular-nums; }
.hist-row .sc text { font-size: 9px; font-weight: 500; }
.hist-row .grow { flex: 1; min-width: 0; }
.hist-row .t { font-size: 13.5px; font-weight: 600; display: block; }
.hist-row .d { font-size: 11.5px; color: var(--text-3); display: block; }
.trend-chart { display: flex; align-items: flex-end; gap: 4px; height: 110px; padding-top: 14px; }
.trend-col { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: flex-end; height: 100%; }
.trend-col .bar { width: 70%; max-width: 18px; border-radius: 3px 3px 0 0; background: #2E6FD8; min-height: 2px; }
.trend-col .bar.zero { background: #EDF1F7; }
.trend-col .num { font-size: 8.5px; color: var(--text-2); margin-bottom: 2px; }
.trend-labels { display: flex; gap: 4px; margin-top: 5px; }
.trend-labels view { flex: 1; text-align: center; font-size: 8.5px; color: var(--text-3); }

/* ---------- 弹层 ---------- */
.detail-mask { position: fixed; left: 0; top: 0; right: 0; bottom: 0; background: rgba(15,23,42,.5); z-index: 90; display: flex; align-items: flex-end; justify-content: center; }
.detail-sheet { background: var(--card); border-radius: 18px 18px 0 0; width: 100%; max-height: 82vh; display: flex; flex-direction: column; }
.detail-head { display: flex; align-items: center; padding: 15px 16px 11px; border-bottom: 1px solid var(--line); }
.detail-head .t { flex: 1; font-size: 16px; font-weight: 600; }
.detail-body { padding: 14px 16px calc(16px + env(safe-area-inset-bottom)); overflow-y: auto; }
