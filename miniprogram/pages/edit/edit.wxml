<view wx:if="{{ready}}">
  <view class="card">
    <view class="card-title">修改题目 <text class="muted-2">{{qid}} · {{typeLabel}}</text></view>
    <view class="hint">只影响这一道题，其他题和练习记录都不动。改答案后这道题的「已掌握 / 未掌握」会被清掉重新判定。</view>
  </view>

  <view class="card">
    <view class="field-label">题干</view>
    <textarea class="ta" value="{{stem}}" bindinput="onStem" maxlength="-1" disable-default-padding="{{true}}" placeholder="题干内容，空位请用全角（ ）" />
    <view class="hint">空位统一写成全角括号「（ ）」，不要用下划线，也不要把答案字母印在空位里。</view>
  </view>

  <block wx:if="{{!isSubj && !isBlank}}">
    <view class="card">
      <view class="card-title">选项</view>
      <view wx:for="{{options}}" wx:key="key" class="opt-edit">
        <view class="key">{{item.key}}</view>
        <input class="ipt" value="{{item.text}}" bindinput="onOptionInput" data-i="{{index}}" maxlength="-1" placeholder="选项文字" />
        <view wx:if="{{options.length > 2}}" class="del" hover-class="hover" bindtap="onRemoveOption" data-i="{{index}}">×</view>
      </view>
      <button wx:if="{{options.length < 8}}" class="btn ghost sm" hover-class="hover" style="margin-top:4px" bindtap="onAddOption">+ 增加选项</button>
    </view>

    <view class="card">
      <view class="card-title">正确答案</view>
      <view wx:if="{{isJudge}}" class="chip-row">
        <view class="chip {{answer === '√' ? 'on' : ''}}" hover-class="hover" bindtap="onPickAnswer" data-k="√">正确 √</view>
        <view class="chip {{answer === '×' ? 'on' : ''}}" hover-class="hover" bindtap="onPickAnswer" data-k="×">错误 ×</view>
      </view>
      <view wx:else class="chip-row">
        <view wx:for="{{options}}" wx:key="key" class="chip {{item.on ? 'on' : ''}}" hover-class="hover" bindtap="onPickAnswer" data-k="{{item.key}}">{{item.key}}</view>
      </view>
      <view class="hint">{{isJudge ? '判断题：选择「正确」或「错误」' : (isMulti ? '多选题：选 2 个以上' : '单选题：只选 1 个')}}</view>
    </view>
  </block>

  <block wx:elif="{{isBlank}}">
    <view class="card">
      <view class="card-title">每空答案 <text class="muted-2">共 {{blankN}} 个空</text></view>
      <view wx:for="{{blanks}}" wx:key="n" class="opt-edit">
        <view class="key">{{item.n}}</view>
        <input class="ipt" value="{{item.val}}" bindinput="onBlankAnswer" data-i="{{index}}" maxlength="-1" placeholder="第 {{item.n}} 空的答案" />
      </view>
      <view wx:if="{{!blanks.length}}" class="hint">题干里还没有空位。先在题干里写出全角「（ ）」，再点下面的按钮。</view>
      <button class="btn ghost sm" hover-class="hover" style="margin-top:8px" bindtap="onSyncBlanks">按题干空位重新排列</button>
      <view class="hint">一个空有多种写法时用竖线分隔，例如 3×10^8|3e8|3*10^8。判分时会忽略空格、全角半角与英文大小写。</view>
    </view>
  </block>

  <view class="card">
    <view class="field-label">{{isSubj ? '参考要点' : '参考答案（可空）'}}</view>
    <textarea class="ta ta-short" value="{{reference}}" bindinput="onRef" maxlength="-1" disable-default-padding="{{true}}" placeholder="{{isSubj ? '主观题没有标准答案，这里写参考要点' : '需要时填，答对后作为补充参考'}}" />
    <view class="field-label">题目解析（可空）</view>
    <textarea class="ta ta-short" value="{{analysis}}" bindinput="onAnalysis" maxlength="-1" disable-default-padding="{{true}}" placeholder="解析内容" />
  </view>

  <view wx:if="{{errs.length}}" class="card">
    <view class="err-line">还有 {{errs.length}} 处问题</view>
    <view wx:for="{{errs}}" wx:key="*this" class="err-item">{{item}}</view>
  </view>

  <view class="card">
    <button class="btn" hover-class="hover" bindtap="onSave">保存修改</button>
    <button wx:if="{{canRestore}}" class="btn gray sm" hover-class="hover" style="margin-top:8px" bindtap="onRestore">还原为修改前的版本</button>
    <view class="hint">保存后立刻生效，正在进行的练习会显示新内容。</view>
  </view>
</view>
