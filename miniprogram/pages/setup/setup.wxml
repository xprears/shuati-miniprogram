<view wx:if="{{empty}}" class="card">
  <view class="card-title">题库为空</view>
  <view class="muted">还没有导入题库。导入一份题库 JSON，即可设置范围开始练习。</view>
  <button class="btn sm" style="margin-top:10px" hover-class="hover" bindtap="goImport">去导入题库</button>
</view>

<block wx:else>
<view class="card">
  <view class="card-title">练习范围</view>
  <view wx:if="{{isWrong}}" class="muted">当前未掌握清单共 {{poolN}} 题。进入后按顺序重做，答对自动移出。</view>
  <view wx:else class="chip-row">
    <view wx:for="{{scopeChips}}" wx:key="key" class="chip {{scope === item.key ? 'on' : ''}}" hover-class="hover" bindtap="onScopeTap" data-key="{{item.key}}">{{item.label}}</view>
  </view>
  <view wx:if="{{scope === 'custom' && !isWrong}}">
    <view style="margin-top:10px">
      <view wx:for="{{chapters}}" wx:key="name" class="scope-item" hover-class="hover" bindtap="onChapterTap" data-name="{{item.name}}">
        <view class="check {{item.sel ? 'on' : ''}}">{{item.sel ? '✓' : ''}}</view>
        <view class="grow">
          <view class="t">{{item.name}}</view>
          <view class="d">{{item.part}} · {{item.count}} 题</view>
        </view>
      </view>
      <view wx:if="{{!chapters.length}}" class="muted-2" style="margin-top:8px">没有可选择的章节</view>
      <view wx:if="{{chapters.length}}" class="muted-2" style="margin-top:8px">点击选择/取消章节</view>
    </view>
  </view>
</view>

<view class="card">
  <view class="card-title">
    <text>题型</text>
    <text class="act" hover-class="hover" bindtap="onTypesAll">全选</text>
  </view>
  <view class="chip-row">
    <view wx:for="{{types}}" wx:key="key" class="chip {{item.on ? 'on' : ''}}" hover-class="hover" bindtap="onTypeTap" data-key="{{item.key}}">{{item.label}}</view>
  </view>
  <view wx:if="{{!types.length}}" class="muted-2" style="margin-top:8px">题库里没有可练习的题型</view>
</view>

<view wx:if="{{counts.length}}" class="card">
  <view class="card-title">题量（当前范围共 {{poolN}} 题）</view>
  <view class="chip-row">
    <view wx:for="{{counts}}" wx:key="n" class="count-pill {{item.on ? 'on' : ''}}" hover-class="hover" bindtap="onCountTap" data-n="{{item.n}}">{{item.label}}</view>
  </view>
  <view wx:if="{{mode === 'rand'}}" class="muted-2" style="margin-top:10px">随机练习按掌握度加权：未掌握 ×4、没做过 ×2、已掌握 ×1。</view>
</view>

<view wx:if="{{durs.length}}" class="card">
  <view class="card-title">测验时长</view>
  <view class="chip-row">
    <view wx:for="{{durs}}" wx:key="n" class="count-pill {{item.on ? 'on' : ''}}" hover-class="hover" bindtap="onDurTap" data-n="{{item.n}}">{{item.label}}</view>
  </view>
</view>

<view wx:if="{{tip}}" class="card">
  <view class="tip-line">{{tip}}</view>
</view>

<button class="btn" hover-class="hover" disabled="{{!startN}}" bindtap="onStart">开始{{modeName}}（{{startN}} 题）</button>
</block>
